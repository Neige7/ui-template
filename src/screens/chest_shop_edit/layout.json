{
  "screen": "shop_edit",
  "rows": 6,
  "title": "§8[§6箱子商店 · 商品管理与配置§8]",
  "clientMode": "mod_client_and_container_hybrid",
  "slots": {
    "0": { "type": "display", "label": "商店基本信息与店主标识" },
    "2": { "type": "tab", "action": "shop_set_currency:gold", "label": "结算货币: 金币 (🪙 Vault)" },
    "3": { "type": "tab", "action": "shop_set_currency:gems", "label": "结算货币: 点券 (💎 PlayerPoints)" },
    "4": { "type": "tab", "action": "shop_set_currency:emerald", "label": "结算货币: 绿宝石 (❇️ 原版货币)" },
    "6": { "type": "hub_nav", "action": "nav_screen:shop_buy", "label": "切换至玩家购买视角" },
    "8": { "type": "display", "label": "装饰边框" },
    "10": { "type": "button", "action": "shop_adjust_price:-100", "label": "-100 单价" },
    "11": { "type": "button", "action": "shop_adjust_price:-10", "label": "-10 单价" },
    "12": { "type": "button", "action": "shop_adjust_price:-1", "label": "-1 单价" },
    "13": { "type": "storage", "action": "shop_target_slot", "label": "上架商品核心槽位 (待上架/展示)" },
    "14": { "type": "button", "action": "shop_adjust_price:+1", "label": "+1 单价" },
    "15": { "type": "button", "action": "shop_adjust_price:+10", "label": "+10 单价" },
    "21": { "type": "button", "action": "shop_price_input", "mcInputSource": "anvil", "label": "直接输入单价 (铁砧)" },
    "23": { "type": "display", "label": "库存容量上限设置" },
    "16": { "type": "button", "action": "shop_adjust_price:+100", "label": "+100 单价" },
    "28": { "type": "button", "action": "shop_deposit_from_inv:64", "label": "从背包存入 64 件" },
    "29": { "type": "button", "action": "shop_deposit_from_inv:all", "label": "背包同类全部存入（受商店上限限制）" },
    "30": { "type": "button", "action": "shop_withdraw_to_inv:64", "label": "从商店取出 64 件至背包" },
    "31": { "type": "button", "action": "shop_withdraw_to_inv:all", "label": "全部取出至背包" },
    "32": { "type": "button", "action": "shop_deposit_from_warehouse:64", "label": "从仓库存入 64 件" },
    "33": { "type": "button", "action": "shop_deposit_from_warehouse:all", "label": "仓库同类全部存入（受商店上限限制）" },
    "34": { "type": "button", "action": "shop_withdraw_to_warehouse:64", "label": "从商店取出 64 件至仓库" },
    "35": { "type": "button", "action": "shop_withdraw_to_warehouse:all", "label": "全部取出至仓库" },
    "41": { "type": "button", "action": "shop_set_stock_quick:300", "label": "一键设为 300 件 (超大库存演示)" },
    "42": { "type": "button", "action": "shop_unlist", "label": "下架商品并退还库存" },
    "36-40": { "type": "display", "label": "指引说明与动态状态栏" },
    "43-44": { "type": "display", "label": "底栏装饰" },
    "45-53": { "type": "display", "label": "底部辅助快捷区" },
    "P0-P26": { "type": "storage", "label": "玩家 3×9 主背包 (点击有物品槽位执行上架/存入)" },
    "P27-P35": { "type": "storage", "label": "玩家 1×9 快捷栏 (点击有物品槽位执行上架/存入)" }
  },
  "layers": ["background", "dynamic_text", "items"],
  "notes": [
    "槽位 13 为核心上架槽位，未上架时显示待上架占位与点击提示，上架后显示商品属性；右键可执行下架退库。",
    "支持超大数量存储 (如 300 件)，突破原版 64 堆叠上限。",
    "点击下方玩家背包 P0~P35 物品时，若商店未上架则自动上架该物品，若已上架同类则存入商店库存。",
    "槽位 28~31 操作玩家背包，槽位 32~35 操作玩家仓库；全部存入受商店库存上限限制。"
  ]
}
